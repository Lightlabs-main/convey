{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/receiver/**/*.ts",
    "src/relayer/client.ts",
    "src/relayer/claim-paymaster.ts",
    "src/relayer/claim-policy.ts",
    "src/relayer/config.ts",
    "src/relayer/okx.ts",
    "src/relayer/rpc.ts",
    "src/relayer/types.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
