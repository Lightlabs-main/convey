{
  "name": "convey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "node script/verify.ts",
    "verify:bundler-rpc": "node --env-file-if-exists=.env script/check-bundler-rpc.ts",
    "account:inspect": "node --env-file=.env script/account.ts",
    "operator:addresses": "node --env-file=.env script/operator-addresses.ts",
    "test": "node --test test/*.test.ts",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "bootstrap:deploy": "node --env-file=.env script/deploy-bootstrap-paymaster.ts",
    "bootstrap:fund": "node --env-file=.env script/fund-bootstrap-paymaster.ts",
    "bootstrap:build": "node --env-file=.env script/build-bootstrap-operation.ts",
    "bootstrap:submit": "node --env-file=.env script/submit-bootstrap-operation.ts",
    "bootstrap:wait": "node --env-file=.env script/wait-bootstrap-operation.ts",
    "bundler:check": "node --env-file=.env script/bundler-check.ts",
    "relayer:check": "node --env-file=.env script/relayer-check.ts",
    "relayer:serve": "node --env-file=.env script/relayer-server.ts",
    "product:deploy": "node --env-file=.env script/deploy-product.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./relayer": "./src/relayer/index.ts",
    "./relayer/server": "./src/relayer/server-index.ts"
  },
  "dependencies": {
    "viem": "^2.56.8"
  }
}
