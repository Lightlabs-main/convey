# X Layer mainnet
XLAYER_CHAIN_ID=196
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_PINNED_BLOCK=0x43f886a

# Browser-safe public runtime settings. Never put the private relay token,
# NodeFlare URL, bundler URL, or any operator key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_XLAYER_RPC_URL=
NEXT_PUBLIC_CONVEY_CLAIM_ESCROW_ADDRESS=
NEXT_PUBLIC_CONVEY_ENTRYPOINT_ADDRESS=0x0000000071727de22e5e9d8baf0edac6f37da032
NEXT_PUBLIC_CONVEY_SMART_WALLET_FACTORY=
NEXT_PUBLIC_CONVEY_SMART_WALLET_IMPLEMENTATION=
NEXT_PUBLIC_CONVEY_CLAIM_PAYMASTER_ADDRESS=
NEXT_PUBLIC_CONVEY_EXIT_PAYMASTER_ADDRESS=
NEXT_PUBLIC_CONVEY_EXIT_ROUTER_ADDRESS=0x4f0c28f5926afda16bf2506d5d9e57ea190f9bca
NEXT_PUBLIC_CONVEY_EXIT_USDT0_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
NEXT_PUBLIC_CONVEY_CLAIM_FUNCTION_SELECTOR=
NEXT_PUBLIC_CONVEY_RECEIVER_SALT=
NEXT_PUBLIC_CONVEY_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_CONVEY_WNVDA_TOKEN_ADDRESS=
NEXT_PUBLIC_CONVEY_WAAPL_TOKEN_ADDRESS=
NEXT_PUBLIC_CONVEY_WTSLA_TOKEN_ADDRESS=

# Verified OKX Smart Wallet deployment (ERC-4337 EntryPoint v0.7)
ENTRYPOINT_ADDRESS=0x0000000071727de22e5e9d8baf0edac6f37da032
OKX_SMART_WALLET_FACTORY=0xdd3fea01cd550c9effc893f346690b9a649f35ef
OKX_SMART_WALLET_IMPLEMENTATION=0xe40ccb2d94975c51bff0c004efdfd9b3a5796fa4

# Convey-owned relay infrastructure. BUNDLER_RPC_URL is private and must not
# be exposed to the browser. Run the pinned operator-controlled OKBund v0.7
# deployment behind the Convey gateway. Its ETH_RPC_URL must be a separate
# X Layer RPC with debug_traceCall and state-override support. The verification
# probe derives the keyed NodeFlare X Layer endpoint from NODEFLARE_API_KEY when
# BUNDLER_EXECUTION_RPC_URL is blank.
BUNDLER_EXECUTION_RPC_URL=
NODEFLARE_API_KEY=
BUNDLER_RPC_URL=

PAYMASTER_ADDRESS=
PAYMASTER_MIN_DEPOSIT_WEI=
PAYMASTER_MIN_STAKE_WEI=
CLAIM_PAYMASTER_SIGNER_PRIVATE_KEY=
# Server-only copy used by the private gateway's claim authorization route.
# Never expose this as a NEXT_PUBLIC_* variable or send it to a browser.
CONVEY_CLAIM_PAYMASTER_SIGNER_PRIVATE_KEY=
# Public hash of a successful live claim UserOperation used only as the first
# gas-limit seed. The gateway reads its fields from the private bundler and
# returns no calldata or secret.
CONVEY_CLAIM_GAS_SEED_USER_OPERATION_HASH=
CLAIM_PAYMASTER_MIN_RESERVE_WEI=
CLAIM_PAYMASTER_MAX_COST_WEI=
CLAIM_PAYMASTER_DEPOSIT_WEI=
CLAIM_PAYMASTER_STAKE_WEI=
CLAIM_PAYMASTER_STAKE_UNSTAKE_DELAY_SEC=
CONVEY_ASSET_REGISTRY_ADDRESS=
CONVEY_CLAIM_PAYMASTER_ADDRESS=
CONVEY_EXIT_PAYMASTER_ADDRESS=
CONVEY_EXIT_PAYMASTER_SIGNER_PRIVATE_KEY=
CONVEY_EXIT_ROUTER_ADDRESS=
CONVEY_EXIT_QUOTER_ADDRESS=
CONVEY_EXIT_USDT0_ADDRESS=
# Live verified Uniswap V3 path per asset: asset:path,asset:path
CONVEY_EXIT_ROUTE_PATHS=
CONVEY_EXIT_DEFAULT_SLIPPAGE_BPS=100
CONVEY_EXIT_DEADLINE_SECONDS=120
# Read-only operations thresholds. These are public addresses and wei floors;
# the monitor never reads or prints private keys.
CONVEY_EXIT_MIN_DEPOSIT_WEI=
CONVEY_EXIT_MIN_STAKE_WEI=
CONVEY_BUNDLER_PUBLIC_ADDRESS=
CONVEY_BUNDLER_MIN_BALANCE_WEI=
CONVEY_UNISWAP_SWAP_ROUTER_ADDRESS=
CONVEY_WNVDA_TOKEN_ADDRESS=
CONVEY_WNVDA_UNDERLYING_ADDRESS=
CONVEY_WTSLA_TOKEN_ADDRESS=
CONVEY_WTSLA_UNDERLYING_ADDRESS=
CONVEY_WAAPL_TOKEN_ADDRESS=
CONVEY_WAAPL_UNDERLYING_ADDRESS=
BOOTSTRAP_PAYMASTER_ADDRESS=
BOOTSTRAP_SPONSOR_NONCE=
BOOTSTRAP_PAYMASTER_VERIFICATION_GAS_LIMIT=
BOOTSTRAP_MAX_COST_CAP_WEI=
BOOTSTRAP_ENTRYPOINT_DEPOSIT_WEI=
BOOTSTRAP_STAKE_WEI=
BOOTSTRAP_STAKE_UNSTAKE_DELAY_SEC=
# Set these from the private bundler's live estimate and approved fee exposure;
# the bootstrap builder rejects missing values and never substitutes defaults.
BOOTSTRAP_ACCOUNT_VERIFICATION_GAS_LIMIT=
BOOTSTRAP_CALL_GAS_LIMIT=
BOOTSTRAP_PRE_VERIFICATION_GAS=
BOOTSTRAP_MAX_FEE_PER_GAS_WEI=
BOOTSTRAP_MAX_PRIORITY_FEE_PER_GAS_WEI=
BOOTSTRAP_OPERATION_FILE=
CONVEY_CLAIM_ESCROW_ADDRESS=
CONVEY_CLAIM_FUNCTION_SELECTOR=
# Drop deployment is dry-run by default. It refuses a configured existing
# address and writes only with both `--confirm` and the exact confirmation
# phrase below, after the anti-bot/access and gas policy has been reviewed.
CONVEY_DROP_ESCROW_ADDRESS=
CONVEY_DROP_CONFIRM=
# Recurring-hook deployment is for a disposable or already multi-owner OKX
# wallet only. It is dry-run by default and requires two confirmations for a
# mainnet write. The recurring wallet must not be the sole-owner receiver.
CONVEY_RECURRING_HOOK_ADDRESS=
CONVEY_RECURRING_WALLET=
CONVEY_RECURRING_ASSET=
CONVEY_RECURRING_MAX_GIFT_AMOUNT=
CONVEY_RECURRING_MAX_RESERVE_WEI=
CONVEY_RECURRING_TOTAL_BUDGET=
CONVEY_RECURRING_EXPIRES_AT=
CONVEY_RECURRING_HOOK_CONFIRM=
RELAYER_RPC_TIMEOUT_MS=15000
RELAYER_MAX_BODY_BYTES=131072
RELAYER_SERVER_BIND=127.0.0.1
RELAYER_SERVER_PORT=8787
# Beneficiary used only for read-only EntryPoint preflight; zero is a neutral
# default and does not become a transaction recipient.
RELAYER_PREFLIGHT_BENEFICIARY=0x0000000000000000000000000000000000000000
CONVEY_RELAYER_URL=
# Optional server-to-server auth; never expose this in a NEXT_PUBLIC_* variable.
CONVEY_RELAYER_AUTH_TOKEN=
# The gateway refuses to start without a token (>= 32 chars). Local loopback
# development only: RELAYER_ALLOW_UNAUTHENTICATED=true.
RELAYER_ALLOW_UNAUTHENTICATED=
RELAYER_AUTHORIZATIONS_PER_ACCOUNT_PER_HOUR=12
# Daily exit sponsorship cap in wei; empty means 25 x the paymaster maxExitCost.
RELAYER_EXIT_DAILY_CAP_WEI=
# Escrow the gas-seed claim targeted when it predates the current escrow (gas limits only).
CONVEY_CLAIM_GAS_SEED_ESCROW_ADDRESS=

# Guarded operator top-up command. It is dry-run unless both --confirm and
# CONVEY_TOPUP_CONFIRM are supplied; target is claim, exit, or both.
CONVEY_TOPUP_TARGET=
CONVEY_TOPUP_CONFIRM=

# Guarded direct-withdrawal operator proof. The script is dry-run unless both
# --confirm and CONVEY_WITHDRAW_CONFIRM are supplied.
CONVEY_PUBLIC_RELAY_URL=https://convey.13-62-181-128.sslip.io/api/relay
WITHDRAWAL_TOKEN=
WITHDRAWAL_RECIPIENT=
WITHDRAWAL_AMOUNT=
CONVEY_WITHDRAW_CONFIRM=

# Dedicated keys only. Never expose these through NEXT_PUBLIC_* variables.
SMART_ACCOUNT_OWNER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
BUNDLER_PRIVATE_KEY=
BOOTSTRAP_PAYMASTER_SIGNER_PRIVATE_KEY=
