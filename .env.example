# X Layer mainnet
XLAYER_CHAIN_ID=196
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_PINNED_BLOCK=0x43f886a

# Browser-safe public runtime settings. Never put the private relay token,
# NodeFlare URL, bundler URL, or any operator key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_XLAYER_RPC_URL=
NEXT_PUBLIC_CONVEY_CLAIM_ESCROW_ADDRESS=

# Verified OKX Smart Wallet deployment (ERC-4337 EntryPoint v0.7)
ENTRYPOINT_ADDRESS=0x0000000071727de22e5e9d8baf0edac6f37da032
OKX_SMART_WALLET_FACTORY=0xdd3fea01cd550c9effc893f346690b9a649f35ef
OKX_SMART_WALLET_IMPLEMENTATION=0xe40ccb2d94975c51bff0c004efdfd9b3a5796fa4

# Convey-owned relay infrastructure. BUNDLER_RPC_URL is private and must not
# be exposed to the browser. Run the pinned operator-controlled OKBund v0.7
# deployment behind the Convey gateway. Its ETH_RPC_URL must be a separate
# X Layer RPC with debug_traceCall and state-override support. The verification
# probe derives the keyed NodeFlare X Layer endpoint from NODEFLARE_API_KEY when
# BUNDLER_EXECUTION_RPC_URL is blank.
BUNDLER_EXECUTION_RPC_URL=
NODEFLARE_API_KEY=
BUNDLER_RPC_URL=

PAYMASTER_ADDRESS=
PAYMASTER_MIN_DEPOSIT_WEI=
PAYMASTER_MIN_STAKE_WEI=
CLAIM_PAYMASTER_SIGNER_PRIVATE_KEY=
# Server-only copy used by the private gateway's claim authorization route.
# Never expose this as a NEXT_PUBLIC_* variable or send it to a browser.
CONVEY_CLAIM_PAYMASTER_SIGNER_PRIVATE_KEY=
CLAIM_PAYMASTER_MIN_RESERVE_WEI=
CLAIM_PAYMASTER_MAX_COST_WEI=
CLAIM_PAYMASTER_DEPOSIT_WEI=
CLAIM_PAYMASTER_STAKE_WEI=
CLAIM_PAYMASTER_STAKE_UNSTAKE_DELAY_SEC=
CONVEY_ASSET_REGISTRY_ADDRESS=
CONVEY_CLAIM_PAYMASTER_ADDRESS=
CONVEY_UNISWAP_SWAP_ROUTER_ADDRESS=
CONVEY_WNVDA_TOKEN_ADDRESS=
CONVEY_WNVDA_UNDERLYING_ADDRESS=
CONVEY_WTSLA_TOKEN_ADDRESS=
CONVEY_WTSLA_UNDERLYING_ADDRESS=
CONVEY_WAAPL_TOKEN_ADDRESS=
CONVEY_WAAPL_UNDERLYING_ADDRESS=
BOOTSTRAP_PAYMASTER_ADDRESS=
BOOTSTRAP_SPONSOR_NONCE=
BOOTSTRAP_PAYMASTER_VERIFICATION_GAS_LIMIT=
BOOTSTRAP_MAX_COST_CAP_WEI=
BOOTSTRAP_ENTRYPOINT_DEPOSIT_WEI=
BOOTSTRAP_STAKE_WEI=
BOOTSTRAP_STAKE_UNSTAKE_DELAY_SEC=
# Set these from the private bundler's live estimate and approved fee exposure;
# the bootstrap builder rejects missing values and never substitutes defaults.
BOOTSTRAP_ACCOUNT_VERIFICATION_GAS_LIMIT=
BOOTSTRAP_CALL_GAS_LIMIT=
BOOTSTRAP_PRE_VERIFICATION_GAS=
BOOTSTRAP_MAX_FEE_PER_GAS_WEI=
BOOTSTRAP_MAX_PRIORITY_FEE_PER_GAS_WEI=
BOOTSTRAP_OPERATION_FILE=
CONVEY_CLAIM_ESCROW_ADDRESS=
CONVEY_CLAIM_FUNCTION_SELECTOR=
RELAYER_RPC_TIMEOUT_MS=15000
RELAYER_MAX_BODY_BYTES=131072
RELAYER_SERVER_BIND=127.0.0.1
RELAYER_SERVER_PORT=8787
# Beneficiary used only for read-only EntryPoint preflight; zero is a neutral
# default and does not become a transaction recipient.
RELAYER_PREFLIGHT_BENEFICIARY=0x0000000000000000000000000000000000000000
CONVEY_RELAYER_URL=
# Optional server-to-server auth; never expose this in a NEXT_PUBLIC_* variable.
CONVEY_RELAYER_AUTH_TOKEN=

# Dedicated keys only. Never expose these through NEXT_PUBLIC_* variables.
SMART_ACCOUNT_OWNER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
BUNDLER_PRIVATE_KEY=
BOOTSTRAP_PAYMASTER_SIGNER_PRIVATE_KEY=
